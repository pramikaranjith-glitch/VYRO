{% comment %}
  SECTION: Philosophy — diagonal-cut ivory-grey panel over editorial image.
{% endcomment %}

<section class="philosophy-section reveal" aria-label="Our philosophy">

  <!-- Editorial image -->
  <div class="philosophy-section__image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000 }}"
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
        sizes="(max-width: 767px) 100vw, 50vw"
        alt="{{ section.settings.image_alt | default: 'Two healthcare professionals in a modern space' }}"
        loading="lazy"
        width="1000"
        height="667"
      >
    {%- else -%}
      <!-- PLACEHOLDER: Philosophy editorial image — MOCK DATA, replace per PLACEHOLDERS.md. Style: 3:2, two professionals seated in modern space -->
      <div style="
        width:100%;height:100%;min-height:560px;
        background:linear-gradient(135deg,#1a2f52 0%,#101E35 100%);
        display:flex;align-items:center;justify-content:center;
        flex-direction:column;gap:1rem;
      " aria-hidden="true">
        <span style="color:rgba(244,241,233,0.1);font-size:var(--text-xs);letter-spacing:0.14em;text-transform:uppercase;">Philosophy Editorial Image</span>
        <span style="color:rgba(244,241,233,0.07);font-size:var(--text-xs);letter-spacing:0.1em;">PLACEHOLDER — MOCK DATA</span>
      </div>
    {%- endif -%}
  </div>

  <!-- Diagonal text panel -->
  <div class="philosophy-section__text">
    <span class="eyebrow eyebrow--sage" style="margin-bottom:var(--space-4);">
      {{ section.settings.eyebrow | default: 'Our Philosophy' }}
    </span>

    <h2 class="philosophy-section__headline">
      {{ section.settings.headline | default: 'MORE THAN JUST MEDICAL WEAR.' }}
    </h2>

    <p class="philosophy-section__body">
      {{ section.settings.body | default: 'At VYRO, we blend professional identity with modern design, creating premium medical apparel for the people who never stop.' }}
    </p>

    <a
      href="{{ section.settings.cta_url | default: '/pages/our-story' }}"
      class="link-underline"
    >
      {{ section.settings.cta_label | default: 'OUR STORY' }}
      <span aria-hidden="true">→</span>
    </a>
  </div>

</section>

{% schema %}
{
  "name": "Philosophy",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image (3:2)",
      "info": "Recommended: two professionals in a modern space. No hospital clutter."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "MORE THAN JUST MEDICAL WEAR."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "At VYRO, we blend professional identity with modern design, creating premium medical apparel for the people who never stop."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Philosophy"
    }
  ]
}
{% endschema %}
