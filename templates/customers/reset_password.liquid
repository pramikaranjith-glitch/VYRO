{% comment %}
  VYRO Theme — Classic Customer Reset Password Template
{% endcomment %}

<!-- Shopify customer accounts note: Classic customer templates are utilized here for full bespoke UI parity; Shopify hosted customer accounts restrict custom design tokens. -->
<div class="auth-page">
  <div class="auth-page__image">
    <img src="/assets/mock/login-editorial.jpg" alt="VYRO Performance Medical Apparel" width="600" height="800">
  </div>
  <div class="auth-page__form-side">
    {% form 'reset_customer_password', class: 'auth-form js-auth-reset' %}
      <div>
        <div class="auth-form__eyebrow">Recovery</div>
        <h1 class="auth-form__title">Reset Account Password</h1>
        <p style="font-size:var(--text-xs);color:var(--sage);margin-top:var(--space-1);line-height:1.6;">
          Enter a new password for {{ email }}.
        </p>
      </div>

      {{ form.errors | default_errors }}

      <div class="form-field form-field--password">
        <label class="form-field__label" for="ResetPassword">New Password</label>
        <div class="form-field__password-wrap">
          <input class="form-field__input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required placeholder="At least 6 characters">
        </div>
      </div>

      <div class="form-field form-field--password">
        <label class="form-field__label" for="PasswordConfirmation">Confirm New Password</label>
        <div class="form-field__password-wrap">
          <input class="form-field__input" type="password" id="PasswordConfirmation" name="customer[password_confirmation]" autocomplete="new-password" required placeholder="Confirm password">
        </div>
      </div>

      <button type="submit" class="btn btn--primary btn--full btn--lg">
        SET NEW PASSWORD
      </button>

      <div class="auth-form__links" style="justify-content:center;margin-top:var(--space-1);">
        <a href="{{ routes.account_login_url }}" class="auth-form__link">Back to Sign In</a>
      </div>

      <div class="auth-form__note">
        Authentication will connect to Shopify customer accounts once the store is set up.
      </div>
    {% endform %}
  </div>
</div>
