{% comment %}
  SNIPPET: product-card
  Usage: {% render 'product-card', product: product %}
  Hover image swap, swatches, quick add, available sizes.
{% endcomment %}

{%- assign card_product = product -%}
{%- assign card_hover_image = card_product.images[1] | default: card_product.featured_image -%}

<article class="product-card" aria-label="{{ card_product.title | escape }}">
  <a href="{{ card_product.url }}" class="product-card__img-wrap" tabindex="-1" aria-hidden="true">
    <!-- Default image -->
    {%- if card_product.featured_image != blank -%}
      <img
        class="product-card__img product-card__img--default"
        src="{{ card_product.featured_image | image_url: width: 600 }}"
        srcset="{{ card_product.featured_image | image_url: width: 400 }} 400w, {{ card_product.featured_image | image_url: width: 600 }} 600w"
        sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 25vw"
        alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
        loading="lazy"
        width="400"
        height="500"
      >
    {%- else -%}
      <div class="product-card__img product-card__img--default" style="width:100%;height:100%;background:linear-gradient(135deg,#1a2f52,#101E35);display:flex;align-items:center;justify-content:center;" aria-hidden="true">
        <span style="color:rgba(244,241,233,0.1);font-size:9px;text-transform:uppercase;letter-spacing:0.1em;">PLACEHOLDER</span>
      </div>
    {%- endif -%}

    <!-- Hover image -->
    {%- if card_hover_image != blank and card_product.images.size > 1 -%}
      <img
        class="product-card__img product-card__img--hover"
        src="{{ card_hover_image | image_url: width: 600 }}"
        alt="{{ card_hover_image.alt | default: card_product.title | append: ' — back view' | escape }}"
        loading="lazy"
        width="400"
        height="500"
        aria-hidden="true"
      >
    {%- endif -%}

    <!-- Quick add -->
    {%- if card_product.variants.first.available -%}
      <button
        class="product-card__quick-add"
        data-variant-id="{{ card_product.variants.first.id }}"
        aria-label="Quick add {{ card_product.title | escape }} to bag"
        onclick="event.preventDefault();"
      >QUICK ADD</button>
    {%- else -%}
      <div class="product-card__quick-add" style="pointer-events:none;opacity:0.5;">SOLD OUT</div>
    {%- endif -%}
  </a>

  <!-- Card info -->
  <div class="product-card__name">
    <a href="{{ card_product.url }}">{{ card_product.title }}</a>
  </div>

  <div class="product-card__price">
    {%- if card_product.compare_at_price > card_product.price -%}
      <span style="text-decoration:line-through;opacity:0.4;margin-right:4px;">{{ card_product.compare_at_price | money }}</span>
    {%- endif -%}
    {{ card_product.price | money }}
  </div>

  <!-- Colour swatches -->
  {%- assign colour_option = card_product.options_with_values | where: 'name', 'Color' | first -%}
  {%- unless colour_option -%}
    {%- assign colour_option = card_product.options_with_values | where: 'name', 'Colour' | first -%}
  {%- endunless -%}
  {%- if colour_option -%}
    <div class="product-card__swatches" aria-label="Available colours">
      {%- for value in colour_option.values -%}
        <span
          class="product-card__swatch{% if forloop.first %} is-active{% endif %}"
          style="background-color:{% case value %}{% when 'Midnight Navy' %}#101E35{% when 'Sage' %}#84958C{% when 'Ivory' %}#F4F1E9{% else %}#101E35{% endcase %};"
          title="{{ value }}"
          aria-label="{{ value }}"
        ></span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <!-- Available sizes -->
  <div class="product-card__sizes" aria-label="Available sizes">
    {%- for variant in card_product.variants -%}
      <span class="product-card__size-label{% unless variant.available %}" style="text-decoration:line-through;opacity:0.3{% endunless %}">
        {{ variant.title }}
      </span>
    {%- endfor -%}
  </div>
</article>
