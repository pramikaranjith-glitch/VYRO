{% comment %}
  SECTION: Header
  Ivory navigation bar with VYRO wordmark, centre nav links, and right action icons.
  Desktop: 3-column grid. Mobile: hamburger | VYRO | search+bag.
{% endcomment %}

<header class="site-header js-site-header" role="banner">
  <div class="site-header__inner">

    <!-- Left: Hamburger (mobile) / empty on desktop -->
    <div class="site-header__left">
      <button
        class="hamburger js-hamburger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
      </button>
    </div>

    <!-- Centre: VYRO Wordmark -->
    <div class="site-logo">
      <a href="{{ routes.root_url }}" class="site-logo__link" aria-label="{{ shop.name }} Home">
        {%- render 'icon-logo', variant: 'navy' -%}
      </a>
    </div>

    <!-- Desktop Centre Nav -->
    <nav class="site-nav" aria-label="Main navigation">

      <!-- Shop with mega menu -->
      <div class="site-nav__item js-mega-trigger" data-menu="shop">
        <button
          class="site-nav__link"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mega-menu-shop"
        >
          Shop
          <svg class="site-nav__chevron" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Mega Menu -->
        <div class="mega-menu" id="mega-menu-shop" role="region" aria-label="Shop navigation">
          <div class="mega-menu__container">
            <!-- Column 1: Shop By Colours -->
            <div class="mega-menu__sidebar">
              <div class="mega-menu__group-label">Shop by Colour</div>
              <div class="mega-menu__swatches">
                <a href="{{ routes.collections_url }}/all?colour=Midnight+Navy" class="mega-menu__swatch-item">
                  <span class="mega-menu__dot" style="background:#101E35;"></span>
                  Midnight Navy
                </a>
                <a href="{{ routes.collections_url }}/all?colour=Sage" class="mega-menu__swatch-item">
                  <span class="mega-menu__dot" style="background:#84958C;"></span>
                  Muted Sage
                </a>
                <a href="{{ routes.collections_url }}/all?colour=Midnight+Navy" class="mega-menu__swatch-item">
                  <span class="mega-menu__dot" style="background:#18181b;"></span>
                  Shadow Black
                </a>
                <a href="{{ routes.collections_url }}/all?colour=Stark+White" class="mega-menu__swatch-item">
                  <span class="mega-menu__dot" style="background:#ffffff;border:1px solid #D5D9DF;"></span>
                  Stark White
                </a>
              </div>

              <div style="margin-top:var(--space-3);border-top:var(--border-hairline);padding-top:var(--space-2);">
                <div class="mega-menu__group-label">Quick Links</div>
                <a href="{{ routes.collections_url }}/all?gender=Men%27s" class="mega-menu__sublink" style="display:block;padding-block:3px;">Men's Collection</a>
                <a href="{{ routes.collections_url }}/all?gender=Women%27s" class="mega-menu__sublink" style="display:block;padding-block:3px;">Women's Collection</a>
                <a href="{{ routes.collections_url }}/all?category=Lab+Coats" class="mega-menu__sublink" style="display:block;padding-block:3px;">Executive Lab Coats</a>
                <a href="{{ routes.collections_url }}/all?category=Essentials" class="mega-menu__sublink" style="display:block;padding-block:3px;">Shift Essentials</a>
              </div>
            </div>

            <!-- Column 2: Scrubs & Sets -->
            <div class="mega-menu__col">
              <a href="{{ routes.collections_url }}/all" class="mega-menu__card-img-wrap" tabindex="-1">
                <img class="mega-menu__card-img" src="{{ 'mock/product-front.jpg' | asset_url }}" alt="VYRO Performance Medical Scrubs" width="240" height="180">
              </a>
              <div class="mega-menu__col-title">Scrubs & Sets</div>
              <div class="mega-menu__sublinks">
                <a href="{{ routes.collections_url }}/all?gender=Men%27s" class="mega-menu__sublink">FLEXFIT 01 Men's Set</a>
                <a href="{{ routes.collections_url }}/all?gender=Women%27s" class="mega-menu__sublink">FLEXFIT 01 Women's Set</a>
                <a href="{{ routes.collections_url }}/all" class="mega-menu__sublink">Kinetic Cargo Pants</a>
              </div>
              <a href="{{ routes.collections_url }}/all" class="mega-menu__view-all">Shop All Scrubs →</a>
            </div>

            <!-- Column 3: Lab Coats -->
            <div class="mega-menu__col">
              <a href="{{ routes.collections_url }}/all?category=Lab+Coats" class="mega-menu__card-img-wrap" tabindex="-1">
                <img class="mega-menu__card-img" src="{{ 'mock/lab-coat-front.jpg' | asset_url }}" alt="VYRO Executive Lab Coats" width="240" height="180">
              </a>
              <div class="mega-menu__col-title">Lab Coats</div>
              <div class="mega-menu__sublinks">
                <a href="{{ routes.collections_url }}/all?category=Lab+Coats" class="mega-menu__sublink">Executive Lab Coat</a>
                <a href="{{ routes.collections_url }}/all?category=Lab+Coats" class="mega-menu__sublink">Focus Clinical Coat</a>
                <a href="{{ routes.collections_url }}/all?category=Lab+Coats" class="mega-menu__sublink">Fluid-Shield Twill</a>
              </div>
              <a href="{{ routes.collections_url }}/all?category=Lab+Coats" class="mega-menu__view-all">Shop All Coats →</a>
            </div>

            <!-- Column 4: Shift Essentials -->
            <div class="mega-menu__col">
              <a href="{{ routes.collections_url }}/all?category=Essentials" class="mega-menu__card-img-wrap" tabindex="-1">
                <img class="mega-menu__card-img" src="{{ 'mock/fabric-macro.jpg' | asset_url }}" alt="VYRO Shift Essentials & Base Layers" width="240" height="180">
              </a>
              <div class="mega-menu__col-title">Shift Essentials</div>
              <div class="mega-menu__sublinks">
                <a href="{{ routes.collections_url }}/all?category=Essentials" class="mega-menu__sublink">Shift Thermal Base Layer</a>
                <a href="{{ routes.collections_url }}/all?category=Accessories" class="mega-menu__sublink">Fluid-Shield Scrub Cap</a>
                <a href="{{ routes.root_url }}#shift-index" class="mega-menu__sublink">Shift Index System</a>
              </div>
              <a href="{{ routes.collections_url }}/all?category=Essentials" class="mega-menu__view-all">Shop Essentials →</a>
            </div>

            <!-- Column 5: Editorial Feature Promo Card -->
            <div class="mega-menu__promo">
              <img class="mega-menu__promo-img" src="{{ 'mock/philosophy-editorial.jpg' | asset_url }}" alt="Clinicians in VYRO Apparel" width="260" height="160">
              <div class="mega-menu__promo-content">
                <span class="mega-menu__promo-badge">Clinical Innovation</span>
                <h4 class="mega-menu__promo-title">ENGINEERED FOR THE 24-HR SHIFT</h4>
                <p class="mega-menu__promo-desc">Zero distraction. Fluid-resistant. Built to uphold professional dignity.</p>
                <a href="/pages/technology" class="mega-menu__promo-btn">View Technology →</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="site-nav__item">
        <a href="/pages/our-story" class="site-nav__link">Our Story</a>
      </div>

      <div class="site-nav__item">
        <a href="/pages/technology" class="site-nav__link">Technology</a>
      </div>

      <div class="site-nav__item">
        <a href="/pages/contact" class="site-nav__link">Contact</a>
      </div>

    </nav>

    <!-- Right: Actions -->
    <div class="site-header__actions">

      <!-- Search -->
      <button class="nav-icon-btn js-search-open" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M21 21L16.65 16.65" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Account button (opens account drawer) -->
      <button type="button" class="nav-icon-btn nav-icon-btn--account js-account-open" aria-label="Account" aria-expanded="false" aria-controls="account-drawer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Cart / Bag -->
      <button class="nav-icon-btn js-cart-open" aria-label="Open cart" aria-controls="cart-drawer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0" stroke-linecap="round"/>
        </svg>
        <span class="cart-badge js-cart-badge" aria-label="Cart items">{{ cart.item_count }}</span>
      </button>

    </div>
  </div>
</header>

<div class="account-drawer" id="account-drawer" role="dialog" aria-modal="false" aria-label="Account">
  <div class="account-drawer__inner">
    <div class="account-drawer__title">Account</div>
    {%- if customer -%}
      <div style="font-size:var(--text-sm);margin-bottom:var(--space-3);">Welcome, {{ customer.first_name }}</div>
      <a href="{{ routes.account_url }}" class="btn btn--primary btn--full" style="margin-top:var(--space-2);">My Orders &amp; Profile</a>
      <a href="{{ routes.account_logout_url }}" class="btn btn--outline btn--full">Sign Out</a>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="btn btn--primary btn--full" style="margin-top:var(--space-2);">Sign In</a>
      <a href="{{ routes.account_register_url }}" class="btn btn--outline btn--full">Create Account</a>
      <p class="account-drawer__note">Authentication will connect to Shopify customer accounts once the store is set up.</p>
    {%- endif -%}
  </div>
</div>

<script>
  // Scroll-triggered header border
  (function(){
    var header = document.querySelector('.js-site-header');
    if (!header) return;
    var observer = new IntersectionObserver(function(entries){
      header.classList.toggle('site-header--scrolled', !entries[0].isIntersecting);
    }, { rootMargin: '-80px 0px 0px 0px' });
    var sentinel = document.querySelector('#main-content');
    if (sentinel) observer.observe(sentinel);
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
