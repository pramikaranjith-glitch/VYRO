{% comment %}
  SECTION: Fit Guide Modal
  Interactive size guide with measurement illustrations (simple line drawings), fit explanations,
  and size chart table. Accessible modal with focus trap and keyboard dismissal.
  All measurements are PLACEHOLDERS pending brand verification.
{% endcomment %}

<div
  class="fit-guide-modal"
  id="fit-guide-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fit-guide-title"
  style="display:none;"
>
  <div class="fit-guide-modal__overlay js-fit-guide-close" aria-hidden="true"></div>

  <div class="fit-guide-modal__box" tabindex="-1">
    <div class="fit-guide-modal__header">
      <div>
        <span class="eyebrow eyebrow--sage" style="margin-bottom:4px;">VYRO Sizing</span>
        <h2 class="h3" id="fit-guide-title" style="margin-bottom:0;">FLEXFIT 01 Fit Guide</h2>
      </div>
      <button
        type="button"
        class="mobile-drawer__close js-fit-guide-close"
        aria-label="Close size guide"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
          <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="fit-guide-modal__body">
      <!-- Left: Line drawing illustration & Measurement tips -->
      <div>
        <div class="fit-guide__illustration" aria-label="Measurement points diagram">
          <svg width="180" height="220" viewBox="0 0 180 220" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Torso outline -->
            <path d="M50 40C60 30 120 30 130 40L160 70L145 90L130 80V180H50V80L35 90L20 70L50 40Z" stroke="var(--navy)" stroke-width="1.5" stroke-linejoin="round" fill="rgba(16,30,53,0.03)"/>
            <!-- Neckline -->
            <path d="M75 35C75 55 105 55 105 35" stroke="var(--navy)" stroke-width="1.5"/>
            <!-- Chest measurement line -->
            <line x1="45" y1="95" x2="135" y2="95" stroke="var(--sage)" stroke-width="1.5" stroke-dasharray="3 3"/>
            <circle cx="90" cy="95" r="3" fill="var(--sage)"/>
            <text x="96" y="92" font-family="var(--font-heading)" font-size="9" font-weight="700" fill="var(--sage)" letter-spacing="0.1em">CHEST</text>
            <!-- Waist measurement line -->
            <line x1="50" y1="135" x2="130" y2="135" stroke="var(--sage)" stroke-width="1.5" stroke-dasharray="3 3"/>
            <circle cx="90" cy="135" r="3" fill="var(--sage)"/>
            <text x="96" y="132" font-family="var(--font-heading)" font-size="9" font-weight="700" fill="var(--sage)" letter-spacing="0.1em">WAIST</text>
            <!-- Length measurement line -->
            <line x1="145" y1="40" x2="145" y2="180" stroke="var(--sage)" stroke-width="1" stroke-dasharray="2 2"/>
            <polyline points="142,43 145,40 148,43" stroke="var(--sage)" stroke-width="1"/>
            <polyline points="142,177 145,180 148,177" stroke="var(--sage)" stroke-width="1"/>
            <text x="150" y="115" font-family="var(--font-heading)" font-size="8" fill="var(--sage)" letter-spacing="0.1em">LENGTH</text>
          </svg>
          <div style="text-align:center;padding:0 var(--space-4);">
            <p style="font-size:var(--text-xs);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--navy);margin-bottom:2px;">Tailored Athletic Fit</p>
            <p style="font-size:var(--text-xs);color:var(--sage);line-height:1.4;">Designed for freedom of movement through the shoulders with a tapered waist.</p>
          </div>
        </div>

        <div style="margin-top:var(--space-4);font-size:var(--text-xs);color:var(--muted);line-height:1.6;">
          <p><strong>Chest:</strong> Measure around the fullest part of your chest, keeping the tape level.</p>
          <p style="margin-top:4px;"><strong>Waist:</strong> Measure around your natural waistline, where scrub pants typically sit.</p>
          <p style="margin-top:4px;color:var(--sage);font-weight:600;">If between sizes, we recommend sizing up for layering.</p>
        </div>
      </div>

      <!-- Right: Size Chart Table (PLACEHOLDER) -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-3);">
          <span style="font-size:var(--text-xs);font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--navy);">Dimensions in Inches</span>
          <span style="font-size:10px;color:var(--sage);letter-spacing:0.06em;text-transform:uppercase;">◎ Pending verification</span>
        </div>

        <table class="fit-guide__table" aria-label="Size chart dimensions">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Chest (in)</th>
              <th scope="col">Waist (in)</th>
              <th scope="col">Hip (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>S</strong></td>
              <td>36 – 38</td>
              <td>29 – 31</td>
              <td>36 – 38</td>
            </tr>
            <tr>
              <td><strong>M</strong></td>
              <td>39 – 41</td>
              <td>32 – 34</td>
              <td>39 – 41</td>
            </tr>
            <tr>
              <td><strong>L</strong></td>
              <td>42 – 44</td>
              <td>35 – 37</td>
              <td>42 – 44</td>
            </tr>
            <tr>
              <td><strong>XL</strong></td>
              <td>45 – 47</td>
              <td>38 – 40</td>
              <td>45 – 47</td>
            </tr>
          </tbody>
        </table>

        <div style="margin-top:var(--space-4);padding:var(--space-3);background:var(--ivory-grey);border-radius:var(--radius-sm);font-size:var(--text-xs);line-height:1.6;">
          <strong style="text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:2px;">Fit Guarantee</strong>
          Free exchanges on all sizes within 30 days. If your set doesn't fit seamlessly, exchange it at zero additional cost.
        </div>

        <div style="margin-top:var(--space-5);text-align:right;">
          <button type="button" class="btn btn--primary js-fit-guide-close">Close Guide</button>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fit Guide Modal",
  "settings": [],
  "presets": [
    {
      "name": "Fit Guide Modal"
    }
  ]
}
{% endschema %}
