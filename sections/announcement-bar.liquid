{% comment %}
  SECTION: Announcement Bar
  Configurable via theme settings.
  Desktop: 3-column (brand mark | message | links)
  Mobile: single approved message
{% endcomment %}

{%- assign ann_message_1 = section.settings.message_1 | default: 'Free Shipping Across India | Easy Returns' -%}

<div class="announcement-bar" role="banner" aria-label="Site announcement">
  <div class="announcement-bar__inner">

    <!-- Left: minimal VYRO mark -->
    <div class="announcement-bar__brand" aria-hidden="true">
      <span class="vyro-mark">VYRO</span>
    </div>

    <!-- Centre: approved message -->
    <div class="announcement-bar__message" aria-live="polite" aria-atomic="true">
      <span class="announcement-bar__message-rotate js-ann-message">
        {{ ann_message_1 }}
      </span>
    </div>

    <!-- Right: utility links -->
    <div class="announcement-bar__links">
      <a href="{{ section.settings.track_order_url | default: '/pages/contact' }}">Track Order</a>
      <a href="{{ section.settings.support_url | default: '/pages/contact' }}">Support</a>
    </div>

  </div>
</div>

<script>
  (function(){
    var msgs = [
      {{ ann_message_1 | json }}
    ];
    var el = document.querySelector('.js-ann-message');
    if (!el || msgs.length < 2) return;
    var idx = 0;
    var interval = {{ section.settings.rotate_interval | default: 4000 }};
    setInterval(function(){
      idx = (idx + 1) % msgs.length;
      el.style.opacity = '0';
      setTimeout(function(){
        el.textContent = msgs[idx];
        el.style.opacity = '1';
      }, 300);
    }, interval);
    el.style.transition = 'opacity 0.3s ease';
  })();
</script>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Message",
      "default": "Free Shipping Across India | Easy Returns"
    },
    {
      "type": "url",
      "id": "track_order_url",
      "label": "Track Order URL"
    },
    {
      "type": "url",
      "id": "support_url",
      "label": "Support URL"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
